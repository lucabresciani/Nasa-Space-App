# Environment for server/ops/compose.yaml (WS12 O1/O1b). Names only, never values; every one is
# optional and has a default in compose.yaml. Copy to server/ops/.env (git-ignored) or export in the
# shell. server/ops/up.sh sets HL_COMMIT, HL_ENGINE_TREE and HL_PROXY_MAX_BODY itself.
HL_COMMIT=
HL_ENGINE_TREE=
HL_SERVER_DATA=
HL_PROXY_PORT=
HL_API_PORT=
HL_PROXY_MAX_BODY=
HL_HEAVY_JOBS_OFF=
# Secret: team token for /api/v1/admin/* (header X-HL-Team). Export it in the shell for the run
# only; never write its value into .env or any other file. Unset = admin disabled (403).
HL_TEAM_TOKEN=
