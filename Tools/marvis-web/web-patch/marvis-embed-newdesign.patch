+// "Maps" switcher (bottom left of the Mission Planer map, PDF "Maps" button): Satellite (HiRISE
+// basemap), Topography (hillshade + contours) and Material composition (rock units inferred from
+// elevation). Rasters are rendered once per type on first use, on the routing grid.
+import { useEffect, useRef, useState } from 'preact/hooks'
+import type { FieldGrid } from '../hud/fields'
+import type { MapType, MissionMap } from './missionMap'
+import type { LonLat } from './plan'
+import { renderRelief, unitBands, UNITS_FILE, type Relief, type Unit } from './relief'
+
+const TYPES: { id: MapType; label: string; swatch: string }[] = [
+  { id: 'satellite', label: 'Satellite', swatch: 'linear-gradient(135deg, #8a5a3c, #c79a6b 55%, #5c3a28)' },
+  { id: 'topo', label: 'Topography', swatch: 'repeating-radial-gradient(circle at 30% 70%, #4e3c2c 0 5px, #e2d6c4 5px 6px)' },
+  { id: 'material', label: 'Material', swatch: 'linear-gradient(180deg, #b394e6 0 33%, #5e93d9 33% 66%, #8fa6bf 66%)' },
+]
+
+export interface ReliefSource {
+  grid: FieldGrid
+  elev: Float32Array
+  resM: number
+  hasBasemap: boolean
+}
+
+async function toBlobUrl(r: Relief): Promise<string> {
+  const canvas = document.createElement('canvas')
+  canvas.width = r.width
+  canvas.height = r.height
+  canvas.getContext('2d')!.putImageData(new ImageData(new Uint8ClampedArray(r.rgba), r.width, r.height), 0, 0)
+  const blob = await new Promise<Blob | null>((res) => canvas.toBlob(res, 'image/png'))
+  if (!blob) throw new Error('could not encode the relief image')
+  return URL.createObjectURL(blob)
+}
+
+export function MapsControl({ mmap, src }: { mmap: MissionMap; src: ReliefSource }) {
+  const [open, setOpen] = useState(false)
+  const [type, setType] = useState<MapType>(src.hasBasemap ? 'satellite' : 'topo')
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+  const [relief, setRelief] = useState<Partial<Record<MapType, Relief>>>({})
+  const [units, setUnits] = useState<Unit[]>([])
+  const seq = useRef(0)
+
+  useEffect(() => {
+    const s = ++seq.current
+    void (async () => {
+      setError(null)
+      if (type === 'satellite') return mmap.setMapType('satellite')
+      let r = relief[type]
+      if (!r) {
+        setBusy(true)
+        await new Promise((res) => setTimeout(res, 20)) // let "Rendering…" paint
+        try {
+          const { grid, elev, resM } = src
+          let lo = Infinity
+          let hi = -Infinity
+          for (const v of elev) if (Number.isFinite(v)) (lo = Math.min(lo, v)), (hi = Math.max(hi, v))
+          const u = type === 'material' ? unitBands(lo, hi) : null
+          r = renderRelief(elev, grid.width, grid.height, resM, type, u)
+          if (u) setUnits(u)
+          setRelief((x) => ({ ...x, [type]: r }))
+        } catch (e) {
+          setError(e instanceof Error ? e.message : String(e))
+          setBusy(false)
+          return
+        }
+      }
+      if (s !== seq.current) return
+      const g = src.grid
+      const corners: [LonLat, LonLat, LonLat, LonLat] = [
+        [g.w, g.n],
+        [g.e, g.n],
+        [g.e, g.s],
+        [g.w, g.s],
+      ]
+      await mmap.setRelief(await toBlobUrl(r), corners)
+      await mmap.setMapType(type)
+      setBusy(false)
+    })()
+  }, [type])
+
+  const cur = TYPES.find((t) => t.id === type)!
+  const r = relief[type]
+  return (
+    <div class="mp-maps">
+      {busy && <div class="mp-maps-legend">Rendering {cur.label.toLowerCase()}…</div>}
+      {error && <div class="mp-maps-legend mp-bad">{error}</div>}
+      {!busy && r && type === 'topo' && (
+        <div class="mp-maps-legend">
+          Contours every {r.contourM} m (bold every {r.contourM * 5} m) · {Math.round(r.minE)} to {Math.round(r.maxE)} m (MOLA areoid), 8 m terrain heights
+        </div>
+      )}
+      {!busy && r && type === 'material' && <MaterialLegend r={r} units={units} />}
+      {open && (
+        <div class="mp-maps-menu" role="menu">
+          {TYPES.map((t) => (
+            <button
+              key={t.id}
+              type="button"
+              role="menuitemradio"
+              aria-checked={t.id === type}
+              class={`mp-maps-tile${t.id === type ? ' on' : ''}`}
+              disabled={t.id === 'satellite' && !src.hasBasemap}
+              title={t.id === 'satellite' && !src.hasBasemap ? 'No basemap tiles in this data tree' : undefined}
+              onClick={() => {
+                setType(t.id)
+                setOpen(false)
+              }}
+            >
+              <span class="mp-maps-swatch" style={{ background: t.swatch }} />
+              {t.label}
+            </button>
+          ))}
+        </div>
+      )}
+      <button type="button" class="mp-maps-btn" aria-expanded={open} onClick={() => setOpen((o) => !o)} title="Change the map type">
+        <span class="mp-maps-swatch" style={{ background: cur.swatch }} />
+        <span>
+          <b>Maps</b>
+          <br />
+          {cur.label}
+        </span>
+      </button>
+    </div>
+  )
+}
+
+function MaterialLegend({ r, units }: { r: Relief; units: Unit[] }) {
+  const shown = units.filter((u) => (r.unitCells.get(u.id) ?? 0) > 0).sort((a, b) => a.lo - b.lo)
+  return (
+    <div class="mp-maps-legend">
+      <b>Rock unit, inferred from elevation</b>
+      <ul>
+        {shown.length ? (
+          shown.map((u) => (
+            <li key={u.id} title={`${u.name}: Curiosity samples from ${Math.round(u.lo)} to ${Math.round(u.hi)} m`}>
+              <span class="mp-swatch" style={{ background: `rgb(${u.rgb.join(',')})` }} />
+              {u.label}
+            </li>
+          ))
+        ) : (
+          <li>No unit band reaches this terrain.</li>
+        )}
+        <li title="Heights above or below every Curiosity sample in the database (it ends at sol 3712, before the boxwork region)">
+          <span class="mp-swatch" style={{ background: 'rgb(70,70,70)' }} />
+          Grey: no sample at that height
+        </li>
+      </ul>
+      <span class="mp-maps-note" title={UNITS_FILE.rule}>
+        Mount Sharp's layers are nearly flat, so each unit is drawn at the heights where Curiosity sampled it (± {UNITS_FILE.band_margin_m} m, fading beyond).
+        Not a mineral survey. Data: Curiosity APXS (PDS), via the team's Unity rock database.
+      </span>
+    </div>
+  )
+}
diff --git a/web/src/mission/budget.test.ts b/web/src/mission/budget.test.ts
new file mode 100644
index 0000000..b4e8d3e
--- /dev/null
+++ b/web/src/mission/budget.test.ts
@@ -0,0 +1,90 @@
+import { describe, expect, it } from 'vitest'
+import { BUDGET_CONSTANTS, missionBudget } from './budget'
+
+describe('mission O2 / time budget (crew.yaml o2_budget, o2_margin; engine margin.py)', () => {
+  it('constants are derived from config exactly as the engine does', () => {
+    // primary_L = 8 h x 1200 BTU/h x 1055.056 J/BTU / 21.0 J/mL / 1000 = 482.3113 L (crew.yaml note: 482.31)
+    expect(BUDGET_CONSTANTS.o2CapacityL).toBeCloseTo(482.31131, 4)
+    // effort rate = 0.5 x 36 x 75 / 1000 = 1.35 L/min; reserve = 30 min x 1.35 = 40.5 L (D24)
+    expect(BUDGET_CONSTANTS.effortRateLMin).toBeCloseTo(1.35, 12)
+    expect(BUDGET_CONSTANTS.reserveL).toBeCloseTo(40.5, 12)
+    expect(BUDGET_CONSTANTS.evaLimitMin).toBe(390) // 6.5 h
+  })
+
+  it('two legs then the way home', () => {
+    const b = missionBudget([{ timeMin: 20, o2L: 30 }, { timeMin: 10, o2L: 12.5 }], { tHomeMin: 25, o2HomeL: 35 })
+    expect(b.walkMin).toBe(30)
+    expect(b.legsKnown).toBe(true)
+    expect(b.tHomeMin).toBe(25)
+    expect(b.evaMin).toBe(55)
+    expect(b.timeMarginMin).toBe(335)
+    expect(b.o2UsedL).toBe(42.5)
+    expect(b.o2LeftL).toBeCloseTo(482.31131 - 42.5, 4)
+    expect(b.o2NeedL).toBeCloseTo(35 + 40.5, 12)
+    expect(b.o2MarginL).toBeCloseTo(482.31131 - 42.5 - 35 - 40.5, 4)
+    expect(b.o2MarginMin).toBeCloseTo((482.31131 - 42.5 - 35 - 40.5) / 1.35, 3)
+  })
+
+  it('no waypoints: the crew stands at the pad, nothing used, home is 0', () => {
+    const b = missionBudget([], { tHomeMin: 0, o2HomeL: 0 })
+    expect(b.walkMin).toBe(0)
+    expect(b.o2LeftL).toBeCloseTo(482.31131, 4)
+    expect(b.o2MarginL).toBeCloseTo(482.31131 - 40.5, 4)
+  })
+
+  it('a leg that could not be routed makes every downstream number unknown', () => {
+    const b = missionBudget([{ timeMin: 20, o2L: 30 }, null], { tHomeMin: 25, o2HomeL: 35 })
+    expect(b.legsKnown).toBe(false)
+    expect(b.walkMin).toBeNull()
+    expect(b.evaMin).toBeNull()
+    expect(b.o2LeftL).toBeNull()
+    expect(b.o2MarginMin).toBeNull()
+  })
+
+  it('unknown way home (no T_home at the last waypoint): home terms unknown, walk-out still known', () => {
+    const b = missionBudget([{ timeMin: 20, o2L: 30 }], { tHomeMin: null, o2HomeL: null })
+    expect(b.walkMin).toBe(20)
+    expect(b.o2LeftL).toBeCloseTo(482.31131 - 30, 4)
+    expect(b.evaMin).toBeNull()
+    expect(b.o2NeedL).toBeNull()
+    expect(b.o2MarginL).toBeNull()
+  })
+
+  it('negative margins stay negative (shown, never clamped)', () => {
+    const b = missionBudget([{ timeMin: 380, o2L: 430 }], { tHomeMin: 30, o2HomeL: 40 })
+    expect(b.timeMarginMin).toBe(-20)
+    expect(b.o2MarginL!).toBeLessThan(0)
+  })
+
+  it('station task rate is derived from 1,000 BTU/h at 21.0 J/mL (D29), as margin.station_task_rate_l_min', () => {
+    // 1000 x 1055.056 / 60 / 21.0 / 1000 = 0.837346 L/min (crew.yaml documents 0.84)
+    expect(BUDGET_CONSTANTS.stationRateLMin).toBeCloseTo(0.8373460, 6)
+  })
+
+  it('planned time at waypoints adds EVA time and O2 at the station task rate', () => {
+    const r = BUDGET_CONSTANTS.stationRateLMin
+    const b = missionBudget([{ timeMin: 20, o2L: 30 }, { timeMin: 10, o2L: 12.5 }], { tHomeMin: 25, o2HomeL: 35 }, [30, 15])
+    expect(b.walkMin).toBe(30)
+    expect(b.stopMin).toBe(45)
+    expect(b.o2StopsL).toBeCloseTo(45 * r, 12)
+    expect(b.evaMin).toBe(30 + 45 + 25)
+    expect(b.timeMarginMin).toBe(390 - 100)
+    expect(b.o2UsedL).toBeCloseTo(42.5 + 45 * r, 12)
+    expect(b.o2MarginL).toBeCloseTo(482.31131 - 42.5 - 45 * r - 35 - 40.5, 4)
+  })
+
+  it('no stop times given equals all zero; bad entries (negative, NaN) count as 0', () => {
+    const legs = [{ timeMin: 20, o2L: 30 }]
+    const home = { tHomeMin: 25, o2HomeL: 35 }
+    expect(missionBudget(legs, home, [0])).toEqual(missionBudget(legs, home))
+    expect(missionBudget(legs, home, [-5])).toEqual(missionBudget(legs, home))
+    expect(missionBudget(legs, home, [Number.NaN])).toEqual(missionBudget(legs, home))
+  })
+
+  it('stop time is known even when a leg is not: O2 and EVA still unknown', () => {
+    const b = missionBudget([null], { tHomeMin: 25, o2HomeL: 35 }, [10])
+    expect(b.stopMin).toBe(10)
+    expect(b.evaMin).toBeNull()
+    expect(b.o2UsedL).toBeNull()
+  })
+})
diff --git a/web/src/mission/budget.ts b/web/src/mission/budget.ts
new file mode 100644
index 0000000..f790d49
--- /dev/null
+++ b/web/src/mission/budget.ts
@@ -0,0 +1,108 @@
+// Mission Planer time and O2 budget, with the engine's terms (pipeline/engine/margin.py):
+//   O2 capacity  = primary_design_eva_h * primary_design_rate_btu_h * j_per_btu / o2_energy_j_per_ml / 1000
+//                  (crew.yaml o2_budget.formula, margin_uses = primary_L; computed, not the rounded 482)
+//   effort rate  = effort_cap_frac * vo2max_ml_kg_min * body_mass_kg / 1000          (L/min)
+//   reserve      = reserve_min_at_effort_cap * effort rate                            (D24, L)
+//   station rate = station_task_rate_btu_h * j_per_btu / 60 / o2_energy_j_per_ml / 1000   (L/min, D29;
+//                  margin.station_task_rate_l_min: 0.8373)
+//   O2 used      = leg O2 + planned stop minutes * station rate   (time at a waypoint is station work)
+//   O2 margin    = (O2 left - O2 home - reserve) / effort rate      (crew.yaml o2_margin.formula; all stop
+//                  O2 is in O2 used, so O2_station_tasks still to do is 0)
+//   EVA          = walk out (legs) + stops + T_home;  time margin = eva_h * 60 - EVA
+// Legs come from the browser router (estimates); T_home and O2 home from WS2's fields at the last waypoint.
+import crewRaw from '../../../config/crew.yaml'
+import { cfg, effortRateLMin } from '../config'
+
+function n(path: string): number {
+  const v = cfg<unknown>(crewRaw, path)
+  if (typeof v !== 'number' || !Number.isFinite(v)) throw new Error(`config/crew.yaml: ${path} is not a number`)
+  return v
+}
+
+function o2Capacity(): number {
+  const formula = cfg<string>(crewRaw, 'o2_budget.formula').split('#', 1)[0].replace(/\s/g, '')
+  if (formula !== 'O2_L=hours*rate_btu_h*j_per_btu/o2_energy_j_per_ml/1000') throw new Error(`o2_budget.formula changed: ${formula}`)
+  if (cfg<string>(crewRaw, 'o2_budget.margin_uses') !== 'primary_L') throw new Error('o2_budget.margin_uses is not primary_L')
+  return (n('o2_budget.primary_design_eva_h') * n('o2_budget.primary_design_rate_btu_h') * n('o2_budget.j_per_btu')) / n('o2_energy_j_per_ml') / 1000
+}
+
+function stationRate(): number {
+  const formula = cfg<string>(crewRaw, 'o2_margin.station_task_rate_formula').replace(/\s/g, '')
+  if (formula !== 'station_task_rate_btu_h*o2_budget.j_per_btu/60/o2_energy_j_per_ml/1000') throw new Error(`station_task_rate_formula changed: ${formula}`)
+  return (n('o2_margin.station_task_rate_btu_h') * n('o2_budget.j_per_btu')) / 60 / n('o2_energy_j_per_ml') / 1000
+}
+
+const effortRate = effortRateLMin({ effortCapFrac: n('effort_cap_frac'), vo2max: n('vo2max_ml_kg_min'), bodyMassKg: n('body_mass_kg') })
+
+export const BUDGET_CONSTANTS = {
+  o2CapacityL: o2Capacity(),
+  effortRateLMin: effortRate,
+  stationRateLMin: stationRate(),
+  reserveL: n('o2_margin.reserve_min_at_effort_cap') * effortRate,
+  evaLimitMin: n('eva_h') * 60,
+} as const
+
+export interface LegCost {
+  timeMin: number
+  o2L: number
+}
+
+export interface MissionBudget {
+  /** false when a leg could not be routed: every downstream number is null */
+  legsKnown: boolean
+  walkMin: number | null
+  /** planned time at the waypoints (always known) */
+  stopMin: number
+  /** O2 for that time at the station task rate */
+  o2StopsL: number
+  tHomeMin: number | null
+  evaMin: number | null
+  evaLimitMin: number
+  timeMarginMin: number | null
+  o2CapacityL: number
+  o2UsedL: number | null
+  o2LeftL: number | null
+  o2HomeL: number | null
+  reserveL: number
+  /** O2 still needed: way home + reserve */
+  o2NeedL: number | null
+  o2MarginL: number | null
+  /** margin in minutes at the effort cap (crew.yaml o2_margin.label) */
+  o2MarginMin: number | null
+}
+
+/** Planned minutes at a waypoint; anything not a positive finite number counts as 0. */
+export const stopMinutes = (v: number | undefined): number => (typeof v === 'number' && Number.isFinite(v) && v > 0 ? v : 0)
+
+export function missionBudget(legs: (LegCost | null)[], home: { tHomeMin: number | null; o2HomeL: number | null }, stops: number[] = []): MissionBudget {
+  const C = BUDGET_CONSTANTS
+  const legsKnown = legs.every((l) => l !== null)
+  const stopMin = stops.reduce((s, v) => s + stopMinutes(v), 0)
+  const o2StopsL = stopMin * C.stationRateLMin
+  const walkMin = legsKnown ? legs.reduce((s, l) => s + l!.timeMin, 0) : null
+  const o2UsedL = legsKnown ? legs.reduce((s, l) => s + l!.o2L, 0) + o2StopsL : null
+  const o2LeftL = o2UsedL === null ? null : C.o2CapacityL - o2UsedL
+  const tHomeMin = legsKnown ? home.tHomeMin : null
+  const o2HomeL = legsKnown ? home.o2HomeL : null
+  const evaMin = walkMin !== null && tHomeMin !== null ? walkMin + stopMin + tHomeMin : null
+  const o2NeedL = o2HomeL !== null ? o2HomeL + C.reserveL : null
+  const o2MarginL = o2LeftL !== null && o2NeedL !== null ? o2LeftL - o2NeedL : null
+  return {
+    legsKnown,
+    walkMin,
+    stopMin,
+    o2StopsL,
+    tHomeMin,
+    evaMin,
+    evaLimitMin: C.evaLimitMin,
+    timeMarginMin: evaMin === null ? null : C.evaLimitMin - evaMin,
+    o2CapacityL: C.o2CapacityL,
+    o2UsedL,
+    o2LeftL,
+    o2HomeL,
+    reserveL: C.reserveL,
+    o2NeedL,
+    o2MarginL,
+    o2MarginMin: o2MarginL === null ? null : o2MarginL / C.effortRateLMin,
+  }
+}
diff --git a/web/src/mission/data.ts b/web/src/mission/data.ts
new file mode 100644
index 0000000..7064ef3
--- /dev/null
+++ b/web/src/mission/data.ts
@@ -0,0 +1,171 @@
+// Everything the Mission Planer reads, for one scenario (default: scenarios/index.json "default").
+//   - routing grid: the shared 5 m field grid (fields/index.json). A cell is walkable iff WS2's
+//     T_home field is known there (WS2 reached it from the pad within its no-go limit: blocked,
+//     unknown and unreached cells have A = 0), so a waypoint can always walk home.
+//   - elevation: fp3d/far.f32.gz (WS8, 8 m, built from WS1's 1 m DEM where it exists), sampled
+//     bilinearly at every cell centre. This is coarser than WS2's 3 m graph, so leg times and O2 are
+//     browser estimates, labelled as such; T_home and O2 home stay WS2's own numbers.
+//   - way home: WS2's pointer field (same path as the HUD's drag-anywhere).
+import { CONFIG } from '../config'
+import { data } from '../data/loader'
+import type { BandsFC, EdgesFC, IsochroneFC, Rad, ScenarioEntry, TileJson } from '../data/types'
+import { dataUrl } from '../env'
+// fp3d/{format,geo,terrain} were removed on main (D99): the functions the planner needs are in ./heights
+import { codecOf, decodeHeights, farOrigin, gunzipIfNeeded, HeightGrid, lonLatToXY, parseEqc, parseIndex } from './heights'
+import { FieldGrid, loadField } from '../hud/fields'
+import type { FieldsIndex as HudFieldsIndex } from '../hud/types'
+import { loadPointer, type PointerField } from '../hud/wayhome'
+import { citesD21, padMarker, type PadMarkerInfo } from '../map/pad'
+import { gradeModel, scenarioParams, type GradeModel } from './physio'
+import type { RouteGrid } from './router'
+
+export interface MissionData {
+  scenario: ScenarioEntry
+  scenarios: ScenarioEntry[]
+  pad: PadMarkerInfo
+  tHome: FieldGrid
+  o2Home: FieldGrid | null
+  pointer: PointerField | null
+  grid: RouteGrid
+  model: GradeModel
+  tilejson: TileJson | null
+  bands: BandsFC | null
+  isochrones: IsochroneFC | null
+  edges: EdgesFC | null
+  /** file each layer came from, for the captions */
+  files: { tHome: string; o2Home: string | null; pointer: string | null; elevation: string; bands: string; isochrones: string; edges: string }
+  elevationResM: number
+  /** WS4 conditions for the margin (mission/margin.ts): the RAD storm series (D39) and the
+   *  minutes from EVA start to darkness; null when the file is missing */
+  rad: Rad | null
+  tDarkMin: number | null
+  /** pad.json pad id and areoid elevation (null without pad.json / when unknown): the mission export's frame */
+  padId: string | null
+  /** official = pad.json cites D21; config_default = no pad.json (site.yaml pad_default); custom = any other pad.json pad */
+  padKind: 'official' | 'custom' | 'config_default'
+  padElevM: number | null
+  /** clock.json eva.start_lmst (D31), or null */
+  evaStartLmst: string | null
+  /** clock.json eva.start_utc and msl_sol (WS4): the EVA start as an instant, for the simulator's sky; null when missing */
+  evaStartUtc: string | null
+  mslSol: number | null
+}
+
+/** clock.json eva.start_utc (WS4), or null. */
+export function evaStartUtcOf(clock: unknown): string | null {
+  const v = (clock as { eva?: { start_utc?: unknown } } | null)?.eva?.start_utc
+  return typeof v === 'string' && /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/.test(v) ? v : null
+}
+
+/** clock.json eva.msl_sol (WS4), or null. */
+export function mslSolOf(clock: unknown): number | null {
+  const v = (clock as { eva?: { msl_sol?: unknown } } | null)?.eva?.msl_sol
+  return typeof v === 'number' && Number.isInteger(v) ? v : null
+}
+
+/** clock.json eva.start_lmst (WS4), or null. */
+export function evaStartLmstOf(clock: unknown): string | null {
+  const v = (clock as { eva?: { start_lmst?: unknown } } | null)?.eva?.start_lmst
+  return typeof v === 'string' && /^[0-9]{2}:[0-9]{2}:[0-9]{2}$/.test(v) ? v : null
+}
+
+/** clock.json eva.t_dark_min (WS4), or null. */
+export function tDarkOf(clock: unknown): number | null {
+  const v = (clock as { eva?: { t_dark_min?: unknown } } | null)?.eva?.t_dark_min
+  return typeof v === 'number' && Number.isFinite(v) ? v : null
+}
+
+async function fetchBuf(path: string): Promise<ArrayBuffer> {
+  const res = await fetch(dataUrl(path))
+  if (!res.ok) throw new Error(`${path}: HTTP ${res.status}`)
+  return res.arrayBuffer()
+}
+
+/** Elevation of every cell centre of `g` from a height grid in the analysis CRS. */
+export function sampleElevation(g: FieldGrid, heights: HeightGrid, toXY: (lon: number, lat: number) => [number, number]): Float32Array {
+  const out = new Float32Array(g.width * g.height)
+  for (let r = 0; r < g.height; r++) {
+    for (let c = 0; c < g.width; c++) {
+      const [lon, lat] = g.lonLatOf(r, c)
+      const [x, y] = toXY(lon, lat)
+      out[r * g.width + c] = heights.bilinear(x, y)
+    }
+  }
+  return out
+}
+
+export async function loadMissionData(scenarioId?: string, onStep?: (what: string) => void): Promise<MissionData> {
+  const L = data()
+  const step = (s: string) => onStep?.(s)
+  step('scenarios and pad')
+  const [idx, fiRaw, padFile, tilejson] = await Promise.all([L.scenarios(), L.fieldsIndex(), L.optional(() => L.pad()), L.optional(() => L.tilejson())])
+  const sid = scenarioId ?? idx.default
+  const scenario = idx.scenarios.find((s) => s.id === sid)
+  if (!scenario) throw new Error(`scenario ${sid} not in scenarios/index.json`)
+  const pad = padMarker(padFile, CONFIG.padDefault)
+  // The HUD's view of the same file (adds the pointer entry's own grid and stencil, contracts v1.1.1).
+  const fi = fiRaw as unknown as HudFieldsIndex
+
+  const tKey = `${sid}/t_home`
+  const oKey = `${sid}/o2_home`
+  const pKey = `${sid}/pointer`
+  if (!fi.fields[tKey]) throw new Error(`fields/index.json has no ${tKey}`)
+  step('walk-home fields')
+  const [tHome, o2Home, pointer] = await Promise.all([
+    loadField(fi, tKey, dataUrl),
+    fi.fields[oKey] ? loadField(fi, oKey, dataUrl) : Promise.resolve(null),
+    fi.fields[pKey]?.stencil ? L.optional(() => loadPointer(fi, pKey, dataUrl)) : Promise.resolve(null),
+  ])
+
+  step('terrain heights')
+  const fp = parseIndex(JSON.parse(new TextDecoder().decode(await fetchBuf('fp3d/index.json'))))
+  const farBuf = await gunzipIfNeeded(await fetchBuf(fp.far.file))
+  const [west, north] = farOrigin(fp)
+  const heights = new HeightGrid(west, north, fp.far.res_m, fp.far.width, fp.far.height, decodeHeights(farBuf, fp.far.width, fp.far.height, codecOf(fp)))
+  const eqc = parseEqc(fp.chunk_grid.crs)
+  const elev = sampleElevation(tHome, heights, (lon, lat) => lonLatToXY(eqc, lon, lat))
+  const passable = new Uint8Array(tHome.width * tHome.height)
+  passable.set(tHome.data.known)
+
+  step('reachable-area layers and conditions')
+  const [bands, isochrones, edges, rad, clock] = await Promise.all([
+    L.optional(() => L.bands(scenario)),
+    L.optional(() => L.isochrones(scenario)),
+    L.optional(() => L.edges(scenario)),
+    L.optional(() => L.rad()),
+    L.optional(() => L.clock()),
+  ])
+
+  return {
+    scenario,
+    scenarios: idx.scenarios,
+    pad,
+    tHome,
+    o2Home,
+    pointer,
+    grid: { width: tHome.width, height: tHome.height, resM: tHome.resM, elev, passable },
+    model: gradeModel(scenarioParams(sid)),
+    tilejson,
+    bands,
+    isochrones,
+    edges,
+    files: {
+      tHome: fi.fields[tKey].file,
+      o2Home: fi.fields[oKey]?.file ?? null,
+      pointer: pointer ? fi.fields[pKey].file : null,
+      elevation: fp.far.file,
+      bands: scenario.files.bands,
+      isochrones: scenario.files.isochrones,
+      edges: scenario.files.edges,
+    },
+    elevationResM: fp.far.res_m,
+    rad,
+    tDarkMin: tDarkOf(clock),
+    padId: padFile ? (padFile.pad.id ?? null) : null,
+    padKind: !padFile ? 'config_default' : citesD21(padFile.pad.source) ? 'official' : 'custom',
+    padElevM: padFile && typeof padFile.pad.elev_m === 'number' ? padFile.pad.elev_m : null,
+    evaStartLmst: evaStartLmstOf(clock),
+    evaStartUtc: evaStartUtcOf(clock),
+    mslSol: mslSolOf(clock),
+  }
+}
diff --git a/web/src/mission/export.test.ts b/web/src/mission/export.test.ts
new file mode 100644
index 0000000..f8ed6f7
--- /dev/null
+++ b/web/src/mission/export.test.ts
@@ -0,0 +1,148 @@
+// Known answers for the mission.json export (contracts/bundle/mission.schema.json): a 10 m leg due
+// east of the pad on a 5 m grid, a 5-min stop, and the way home back along the same cells.
+import { readFileSync } from 'node:fs'
+import { resolve } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { CONFIG } from '../config'
+import { lonLatToXY, parseEqc, type Eqc } from './heights'
+import { BUDGET_CONSTANTS, missionBudget } from './budget'
+import { buildMission, finalizeMission, type MissionExportInput } from './export'
+import { buildTrack, doseTimingFromRad, legProfile, missionMargin } from './margin'
+import type { Rad } from '../data/types'
+import type { LonLat, Waypoint } from './plan'
+import type { Leg } from './router'
+
+// Inverse of lonLatToXY (the removed fp3d/geo.ts had it; heights.ts keeps only the forward one).
+const xyToLonLat = (p: Eqc, x: number, y: number): [number, number] => {
+  const DEG = Math.PI / 180
+  return [p.lon0Deg + (x - p.x0) / (p.R * Math.cos(p.latTsDeg * DEG)) / DEG, p.lat0Deg + (y - p.y0) / p.R / DEG]
+}
+
+const eqc = parseEqc(CONFIG.analysisProj)
+const PAD: LonLat = [137.39, -4.8]
+const [PX, PY] = lonLatToXY(eqc, PAD[0], PAD[1])
+const PAD_ELEV = -3700
+const W = 3
+/** cell = row * 3 + col; cell 0 is the pad, cols go east in 5 m steps */
+const cellLonLat = (c: number): LonLat => xyToLonLat(eqc, PX + (c % W) * 5, PY - Math.floor(c / W) * 5)
+const xOf = (lon: number, lat: number) => lonLatToXY(eqc, lon, lat)[0] - PX
+const homeAt = (lon: number, lat: number) => ({ tHomeMin: (xOf(lon, lat) / 5) * 0.1, o2HomeL: xOf(lon, lat) * 0.01 })
+const elevAt = (lon: number, lat: number) => PAD_ELEV + xOf(lon, lat) / 10
+
+const LEG: Leg = { cells: [0, 1, 2], timeS: 12, o2L: 0.2, distM: 10, tauS: [0, 6, 12], o2CumL: [0, 0.1, 0.2] }
+const [WLON, WLAT] = cellLonLat(2)
+const WP: Waypoint = { id: 7, lon: WLON, lat: WLAT, cell: 2, note: 'core sample', tags: ['Drill'], stopMin: 5 }
+
+function input(legs: (Leg | null)[]): MissionExportInput {
+  const home = homeAt(WLON, WLAT)
+  const budget = missionBudget(legs.map((l) => (l ? { timeMin: l.timeS / 60, o2L: l.o2L } : null)), home, [WP.stopMin])
+  const cellHome = (c: number) => homeAt(...cellLonLat(c))
+  const track = legs.every((l) => l) ? buildTrack(legs.map((l) => legProfile(l!, cellHome)), [WP.stopMin]) : null
+  return {
+    proj: CONFIG.analysisProj,
+    pad: { kind: 'official', id: 'rank1', lon: PAD[0], lat: PAD[1], elevM: PAD_ELEV, source: 'test' },
+    scenario: { id: 'nom_104', variant: 'nominal', suit_kg: 104 },
+    planner: { gridResM: 5, elevationResM: 8, files: {} },
+    constants: { ...BUDGET_CONSTANTS, marginAmberMin: CONFIG.marginAmberMin },
+    conditions: { evaStartLmst: '09:00:00', tDarkMin: 500, storm: false },
+    wps: [WP],
+    legs,
+    homePath: [cellLonLat(2), cellLonLat(1), cellLonLat(0)],
+    homeReachesPad: true,
+    budget,
+    margin: missionMargin(track, { tDarkMin: 500, rad: null, storm: false }),
+    cellLonLat,
+    elevAt,
+    homeAt,
+    label: CONFIG.simulatedLabel,
+    dummy: false,
+  }
+}
+
+type Doc = Record<string, any> // eslint-disable-line @typescript-eslint/no-explicit-any
+
+describe('buildMission', () => {
+  const doc = buildMission(input([LEG])) as Doc
+
+  it('puts the pad at the origin of the pad-local frame', () => {
+    expect(doc.frame.projection.pad_xy_m).toEqual([Math.round(PX * 1e4) / 1e4, Math.round(PY * 1e4) / 1e4])
+    expect(doc.path.rows[0]).toEqual([1, 0, 0, 0, 0, 0, 0, 0, 0])
+    expect(doc.world.plan_bundle_id).toBe('rank1.nom_104')
+  })
+
+  it('converts the out leg to metres, minutes and litres', () => {
+    expect(doc.legs[0]).toMatchObject({ leg: 1, kind: 'out', from: 'pad', to: 'wp1', routed: true, length_m: 10, time_min: 0.2, o2_l: 0.2, t_start_min: 0, t_end_min: 0.2, first_row: 0, n_rows: 3 })
+    expect(doc.path.rows[2]).toEqual([1, 10, 10, 0, 1, 0.2, 0.2, 0.2, 0.1])
+  })
+
+  it('times the waypoint stop at the station task rate', () => {
+    const w = doc.waypoints[0]
+    expect(w).toMatchObject({ index: 1, id: 7, x_m: 10, y_m: 0, z_m: 1, note: 'core sample', tags: ['Drill'], stop_min: 5, arrive_t_min: 0.2, leave_t_min: 5.2, t_home_min: 0.2, o2_home_l: 0.1 })
+    expect(w.o2_used_at_leave_l).toBeCloseTo(0.2 + 5 * BUDGET_CONSTANTS.stationRateLMin, 3)
+  })
+
+  it('times the way home from T_home and O2_home along the pointer path', () => {
+    expect(doc.legs[1]).toMatchObject({ leg: 2, kind: 'home', from: 'wp1', to: 'pad', routed: true, length_m: 10, time_min: 0.2, t_start_min: 5.2, t_end_min: 5.4, first_row: 3, n_rows: 3 })
+    const last = doc.path.rows[5]
+    expect(last.slice(0, 6)).toEqual([2, 10, 0, 0, 0, 5.4])
+    expect(last[6]).toBeCloseTo(doc.waypoints[0].o2_used_at_leave_l + 0.1, 3)
+  })
+
+  it('carries the planned margin and calls the mission feasible', () => {
+    expect(doc.timeline.rows[0].slice(0, 3)).toEqual([0, 'depart', null])
+    expect(doc.timeline.rows.at(-1)[1]).toBe('return')
+    expect(doc.timeline.rows.find((r: unknown[]) => r[1] === 'arrive')[2]).toBe(1) // 1-based waypoint
+    expect(doc.summary.feasible).toBe(true)
+    expect(doc.conditions).toEqual({
+      eva_start_lmst: '09:00:00', t_dark_min: 500, storm_replay: false, t_star_min: null, eva_start_utc: null, msl_sol: null, dose: null,
+    })
+  })
+
+  it('marks an unrouted leg: nulls, no timeline, not feasible', () => {
+    const bad = buildMission(input([null])) as Doc
+    expect(bad.legs[0]).toMatchObject({ routed: false, time_min: null, first_row: null, n_rows: 0 })
+    expect(bad.waypoints[0].arrive_t_min).toBeNull()
+    expect(bad.timeline).toBeNull()
+    expect(bad.summary.feasible).toBe(false)
+  })
+})
+
+describe('EVA clock and storm replay for the simulator', () => {
+  const rad = JSON.parse(readFileSync(resolve(__dirname, '../../public/data/conditions/rad.json'), 'utf8')) as Rad
+
+  it('passes the EVA start instant and MSL sol through', () => {
+    const inp = input([LEG])
+    inp.conditions = { ...inp.conditions, evaStartUtc: '2026-11-14T10:51:18Z', mslSol: 5074 }
+    const c = (buildMission(inp) as Doc).conditions
+    expect(c.eva_start_utc).toBe('2026-11-14T10:51:18Z')
+    expect(c.msl_sol).toBe(5074)
+  })
+
+  it('exports the D39 dose series on the EVA clock only with the storm switch on', () => {
+    const inp = input([LEG])
+    const legs = [LEG]
+    const cellHome = (c: number) => homeAt(...cellLonLat(c))
+    const track = buildTrack(legs.map((l) => legProfile(l, cellHome)), [WP.stopMin])
+    const stormy = { ...inp, margin: missionMargin(track, { tDarkMin: 500, rad, storm: true }), conditions: { ...inp.conditions, storm: true, rad } }
+    const c = (buildMission(stormy) as Doc).conditions
+    const dt = doseTimingFromRad(c.t_star_min, rad)
+    expect(c.storm_replay).toBe(true)
+    expect(c.dose.d_allow_mgy).toBe(dt.dAllowMgy)
+    expect(c.dose.series.length).toBe(dt.evaMin.length)
+    expect(c.dose.series[0][0]).toBeCloseTo(dt.evaMin[0], 3)
+    expect(c.dose.series[0][1]).toBeCloseTo(dt.rateMgyH[0], 6)
+    // same mission, switch off: no series
+    expect((buildMission({ ...stormy, conditions: { ...stormy.conditions, storm: false } }) as Doc).conditions.dose).toBeNull()
+  })
+})
+
+describe('finalizeMission', () => {
+  it('gives the same plan the same id at any time', async () => {
+    const doc = buildMission(input([LEG]))
+    const a = await finalizeMission(doc, new Date('2026-11-15T10:00:00.123Z'))
+    const b = await finalizeMission(doc, new Date('2026-11-15T11:30:00Z'))
+    expect(a.mission_id).toMatch(/^m-[0-9a-f]{12}$/)
+    expect(a.mission_id).toBe(b.mission_id)
+    expect(a.created_utc).toBe('2026-11-15T10:00:00Z')
+  })
+})
