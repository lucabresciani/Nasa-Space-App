+/* Mission Planer (/mission): map left, panel right (PDF "Mission Planer" layout, app colours). */
+.mission-panel { width: 380px; }
+.mp-body h2 { margin-bottom: 0.25rem; }
+.mp-card { background: var(--panel-2, #2b221e); border: 1px solid var(--line); border-radius: 12px; padding: 0.6rem 0.8rem; margin: 0.75rem 0; }
+.mp-card h3 { margin-top: 0.1rem; }
+.mp-storm { display: block; margin-top: 0.45rem; font-size: 0.85rem; color: var(--muted); cursor: pointer; }
+.mp-storm:has(input:disabled) { opacity: 0.6; cursor: default; }
+.mp-card details + details { margin-top: 0.6rem; border-top: 1px solid var(--line); padding-top: 0.5rem; }
+.mp-card summary { cursor: pointer; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 600; }
+.mp-est { display: grid; gap: 0.2rem; }
+.mp-row { display: flex; justify-content: space-between; gap: 0.75rem; font-size: 0.9rem; }
+.mp-row span { color: var(--muted); }
+.mp-row b { font-variant-numeric: tabular-nums; text-align: right; }
+.mp-row.mp-ok b { color: var(--ok); }
+.mp-row.mp-bad b, .mp-bad { color: var(--bad); }
+.mp-sep { border-top: 1px solid var(--line); margin: 0.3rem 0; }
+.mp-notice { border-left: 3px solid var(--warn); background: rgba(233, 185, 73, 0.08); padding: 4px 8px; font-size: 0.85rem; margin: 0.5rem 0; }
+.mp-empty { font-size: 0.85rem; margin: 0.5rem 0 0.2rem; }
+.mp-list { list-style: none; padding: 0; margin: 0.5rem 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.35rem; }
+/* min-width 0: a long one-line summary (closed editor) must not widen the list past the panel */
+.mp-list li { border: 1px solid var(--line); border-radius: 8px; padding: 0.3rem 0.5rem; min-width: 0; }
+.mp-list li.mp-li-bad { border-color: var(--bad); }
+.mp-li-head { display: flex; align-items: center; gap: 0.5rem; }
+.mp-num { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: #1a120e; font: 700 11px system-ui, sans-serif; flex: none; }
+.mp-leg { flex: 1; min-width: 0; font-size: 0.85rem; }
+.mp-actions { display: flex; gap: 2px; }
+.mp-actions button, .mp-clear { background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: 4px; padding: 1px 6px; cursor: pointer; font-size: 0.8rem; }
+.mp-actions button:disabled { opacity: 0.35; cursor: default; }
+.mp-actions button:not(:disabled):hover, .mp-clear:hover { border-color: var(--accent); }
+.mp-li-body { font-size: 0.82rem; color: var(--muted); margin: 0.15rem 0 0 1.9rem; font-variant-numeric: tabular-nums; }
+.mp-select select { width: 100%; margin: 0.5rem 0 0.25rem; background: var(--bg); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 4px 6px; }
+.mp-sources { margin-top: 1rem; }
+.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+.mp-wp { width: 24px; height: 24px; border-radius: 50%; background: var(--accent, #e8925a); color: #1a120e; border: 2px solid #1a120e; display: grid; place-items: center; font: 700 11px system-ui, sans-serif; cursor: grab; box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.6); }
+.mp-wp-bad { background: var(--bad, #e5604d); }
+@media (max-width: 760px) {
+  .mission-panel { width: auto; }
+}
+/* Maps switcher (bottom left, above the scale bar) */
+.mp-maps { position: absolute; left: 10px; bottom: 38px; z-index: 3; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; max-width: 280px; font: 12px system-ui, sans-serif; }
+.mp-maps-btn { display: flex; align-items: center; gap: 8px; background: rgba(33, 26, 23, 0.94); color: var(--ink); border: 1px solid var(--line); border-radius: 10px; padding: 5px 10px 5px 5px; cursor: pointer; text-align: left; line-height: 1.2; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4); }
+.mp-maps-btn:hover, .mp-maps-tile:hover:not(:disabled) { border-color: var(--accent); }
+.mp-maps-swatch { width: 34px; height: 34px; border-radius: 7px; border: 1px solid rgba(255, 255, 255, 0.35); flex: none; display: inline-block; }
+.mp-maps-menu { display: flex; gap: 6px; background: rgba(33, 26, 23, 0.94); border: 1px solid var(--line); border-radius: 10px; padding: 6px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4); }
+.mp-maps-tile { display: flex; flex-direction: column; align-items: center; gap: 4px; background: transparent; color: var(--ink); border: 1px solid transparent; border-radius: 8px; padding: 4px 6px; cursor: pointer; font-size: 11px; }
+.mp-maps-tile .mp-maps-swatch { width: 44px; height: 44px; }
+.mp-maps-tile.on { border-color: var(--accent); }
+.mp-maps-tile:disabled { opacity: 0.4; cursor: default; }
+.mp-maps-legend { background: rgba(33, 26, 23, 0.94); border: 1px solid var(--line); border-radius: 8px; padding: 6px 8px; color: var(--ink); }
+.mp-maps-legend ul { list-style: none; margin: 4px 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px 8px; }
+.mp-maps-legend li { display: flex; align-items: center; gap: 5px; }
+.mp-swatch { width: 12px; height: 12px; border-radius: 2px; flex: none; display: inline-block; }
+.mp-maps-note { display: block; color: var(--muted); font-size: 11px; }
+/* Waypoint editor: stop time, tags, note */
+.mp-wpe { margin: 0.25rem 0 0.1rem 1.9rem; font-size: 0.82rem; min-width: 0; }
+.mp-wpe summary { display: block; cursor: pointer; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.mp-wpe summary::before { content: '▸ '; color: var(--muted); }
+.mp-wpe[open] summary::before { content: '▾ '; }
+.mp-wpe summary::-webkit-details-marker { display: none; }
+.mp-wpe[open] summary { white-space: normal; }
+.mp-wpe-stop { display: flex; align-items: center; gap: 0.4rem; margin: 0.4rem 0; }
+.mp-wpe-stop span:first-child { color: var(--muted); }
+.mp-wpe input, .mp-wpe textarea { background: var(--bg); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 3px 6px; font: inherit; }
+.mp-wpe input { width: 4.5rem; font-variant-numeric: tabular-nums; }
+.mp-wpe textarea { width: 100%; box-sizing: border-box; resize: vertical; margin-top: 0.35rem; }
+.mp-wpe input:focus, .mp-wpe textarea:focus { outline: none; border-color: var(--accent); }
+.mp-tags { display: flex; flex-wrap: wrap; gap: 4px; }
+.mp-tags button { background: transparent; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 1px 8px; cursor: pointer; font-size: 0.75rem; }
+.mp-tags button:hover { border-color: var(--accent); }
+.mp-tags button.on { background: var(--accent); border-color: var(--accent); color: #1a120e; }
+.mp-wp-noted { box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.6), 0 0 0 4px var(--accent, #e8925a); }
+.mp-share { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.4rem; font-size: 0.78rem; }
+/* Science stations on the planner map */
+.mp-station { width: 28px; height: 28px; font-size: 10px; opacity: 0.92; }
+.mp-station.in-plan { box-shadow: 0 0 0 3px var(--accent, #e8925a); }
+.mp-st-pop { display: grid; gap: 6px; font: 12px system-ui, sans-serif; color: #1a120e; }
+.mp-st-pop div { display: flex; align-items: center; gap: 10px; }
+.mp-st-pop button { background: #1a120e; color: #fff; border: 0; border-radius: 6px; padding: 3px 8px; cursor: pointer; font: inherit; }
+.mp-st-pop button:disabled { opacity: 0.5; cursor: default; }
+.mp-st-pop a { color: #8a3b12; font-weight: 600; }
+.mp-st-link { margin-left: 0.5rem; font-size: 0.78rem; white-space: nowrap; }
+/* Embedded in MARVIS (marvis/bridge.ts): start the EVA in the simulator; the EVA debrief card */
+.mp-start { display: block; width: 100%; min-height: 40px; margin-bottom: 0.5rem; padding: 0.45rem 0.9rem; background: var(--accent); color: #1a120e; border: 1px solid var(--accent); border-radius: 8px; font: inherit; font-weight: 700; cursor: pointer; }
+.mp-start:hover:not(:disabled) { background: #f0a472; border-color: #f0a472; }
+.mp-start:active:not(:disabled) { transform: translateY(1px); }
+.mp-start:disabled { opacity: 0.45; cursor: default; }
+.mp-start[aria-busy='true'] { opacity: 0.8; cursor: progress; }
+.mp-start:focus-visible, .mp-download:focus-visible, .mp-debrief .mp-clear:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
+.mp-start-err { margin: 0 0 0.5rem; padding: 4px 8px; border: 1px solid var(--bad); border-radius: 6px; font-size: 0.85rem; overflow-wrap: anywhere; }
+.mp-download { min-height: 28px; padding: 3px 10px; }
+.mp-download:disabled { opacity: 0.45; cursor: default; }
+.mp-download + .muted { display: block; margin-top: 0.35rem; }
+.mp-debrief { border-color: var(--accent); }
+.mp-debrief-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
+.mp-debrief-head h3 { margin: 0.1rem 0; color: var(--ink); }
+.mp-debrief .mp-clear { min-height: 28px; padding: 2px 10px; }
+.mp-debrief-label { margin: 0.3rem 0 0.5rem; }
+.mp-debrief-origin { display: block; margin-top: 0.25rem; color: var(--muted); font-size: 0.8rem; overflow-wrap: anywhere; }
+.mp-row.mp-warn b { color: var(--warn); }
+.mp-debrief-legend { margin-top: 0.5rem; border-top: 1px solid var(--line); padding-top: 0.4rem; }
+@media (prefers-reduced-motion: no-preference) {
+  .mp-start { transition: transform 80ms ease-out; }
+}
+
+/* ---- MARVIS build: the planner inside the new shell (ui/shell) ----
+   Layout unchanged. Inside the shell frame the old page variables read the shell's tokens
+   (ui/tokens.css), so colours, fonts and radii match the rest of the app; the legacy frame
+   (?legacy=1) keeps the old look. Colour meaning as in the shell: text colour for the user's own
+   points and the primary action, yellow only for the focus ring, safe / caution / limit for margins. */
+.hl-shell .mission {
+  --bg: var(--color-bg);
+  --panel: var(--color-sidebar);
+  --panel-2: var(--color-card);
+  --ink: var(--color-text);
+  --muted: var(--color-text-muted);
+  --line: var(--color-card-border);
+  --accent: var(--color-text);
+  --ok: var(--color-safe);
+  --warn: var(--color-caution);
+  --bad: var(--color-limit);
+  font-family: var(--font-text);
+  line-height: var(--line-height-body);
+  color: var(--color-text);
+}
+.hl-shell .mission code { font-family: var(--font-mono); }
+.hl-shell .mission .mp-card, .hl-shell .mission .mp-maps-btn, .hl-shell .mission .mp-maps-menu, .hl-shell .mission .mp-maps-legend { border-radius: var(--radius-card); }
+.hl-shell .mission .mp-maps-btn, .hl-shell .mission .mp-maps-menu, .hl-shell .mission .mp-maps-legend { background: var(--color-card); }
+.hl-shell .mission .mp-list li, .hl-shell .mission .mp-start, .hl-shell .mission .mp-start-err, .hl-shell .mission .mp-select select,
+.hl-shell .mission .mp-wpe input, .hl-shell .mission .mp-wpe textarea, .hl-shell .mission .mp-maps-tile, .hl-shell .mission .mp-maps-swatch { border-radius: var(--radius-input); }
+.hl-shell .mission .mp-notice { background: color-mix(in srgb, var(--color-caution) 10%, transparent); }
+.hl-shell .mission .mp-start:hover:not(:disabled) { background: color-mix(in srgb, var(--color-text) 86%, var(--color-bg)); border-color: transparent; }
+.hl-shell .mission :focus-visible { outline: var(--line-focus-ring) solid var(--color-select); outline-offset: var(--line-focus-ring); }
+/* The timeline dock under the map shows the official plan's EVA clock, not the plan made here: hidden on this page. */
+body[data-route='mission'] .hl-shell .hl-dock { display: none; }
diff --git a/web/src/mission/missionMap.ts b/web/src/mission/missionMap.ts
new file mode 100644
index 0000000..088fd76
--- /dev/null
+++ b/web/src/mission/missionMap.ts
@@ -0,0 +1,268 @@
+// Mission Planer map (plain TS + MapLibre, offline like the Plan page): HiRISE basemap, the chosen
+// reachable-area boundary, planned legs (solid), the way home from the last waypoint (dashed),
+// the pad, and numbered draggable waypoints. Click adds a waypoint. Embedded in MARVIS, the track
+// walked in the simulator is drawn over the plan (EVA debrief).
+import { LngLatBounds, Map as MlMap, Marker, NavigationControl, Popup, setWorkerUrl, type GeoJSONSource, type MapMouseEvent } from 'maplibre-gl'
+import type { FilterSpecification } from '@maplibre/maplibre-gl-style-spec'
+import 'maplibre-gl/dist/maplibre-gl.css'
+import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url'
+import { CONFIG } from '../config'
+import type { AnyFC, BandsFC, EdgesFC, IsochroneFC } from '../data/types'
+import type { BasemapSource } from '../map/basemap'
+import { blankStyle } from '../map/consoleMap'
+import { MarsScaleControl } from '../map/scale'
+import { THEME } from '../theme'
+import type { BoundaryOption, LonLat } from './plan'
+
+setWorkerUrl(workerUrl)
+
+const EMPTY: AnyFC = { type: 'FeatureCollection', features: [] }
+const NOTHING: FilterSpecification = ['==', ['literal', 1], 0]
+
+export type MapType = 'satellite' | 'topo' | 'material'
+
+export interface MissionMapHandlers {
+  onAdd: (lon: number, lat: number) => void
+  onMove: (index: number, lon: number, lat: number) => void
+}
+
+export class MissionMap {
+  readonly map: MlMap
+  private readonly ready: Promise<void>
+  private markers: Marker[] = []
+  private stationMarkers: Marker[] = []
+  private popup?: Popup
+  private padMarker?: Marker
+  private hasBasemap = false
+  private basemapIds: string[] = []
+  private reliefUrl: string | null = null
+  private mapType: MapType = 'satellite'
+  private readonly h: MissionMapHandlers
+
+  constructor(container: HTMLElement, handlers: MissionMapHandlers) {
+    this.h = handlers
+    const f = CONFIG.aoiFocus
+    this.map = new MlMap({
+      container,
+      style: blankStyle(),
+      bounds: [f.west, f.south, f.east, f.north],
+      fitBoundsOptions: { padding: 40 },
+      attributionControl: false,
+      maxPitch: 0,
+      dragRotate: false,
+      renderWorldCopies: false,
+      doubleClickZoom: false, // a double click would add two waypoints and zoom
+    })
+    this.map.touchZoomRotate.disableRotation()
+    this.map.addControl(new NavigationControl({ showCompass: false }), 'top-left')
+    this.map.addControl(new MarsScaleControl(CONFIG.marsRadiusM), 'bottom-left')
+    this.map.getCanvas().style.cursor = 'crosshair'
+    this.ready = new Promise((res) => this.map.once('load', () => res()))
+    void this.ready.then(() => this.init())
+  }
+
+  whenReady(): Promise<void> {
+    return this.ready
+  }
+
+  private init(): void {
+    const m = this.map
+    for (const id of ['band', 'iso', 'edges', 'legs', 'home', 'walked']) m.addSource(id, { type: 'geojson', data: EMPTY })
+    m.addLayer({ id: 'band-fill', type: 'fill', source: 'band', filter: NOTHING, paint: { 'fill-color': THEME.variant.nominal, 'fill-opacity': 0.18 } })
+    m.addLayer({ id: 'band-line', type: 'line', source: 'band', filter: NOTHING, paint: { 'line-color': THEME.variant.nominal, 'line-width': 2.5 } })
+    m.addLayer({ id: 'iso-fill', type: 'fill', source: 'iso', filter: NOTHING, paint: { 'fill-color': THEME.variant.nominal, 'fill-opacity': 0.15 } })
+    m.addLayer({ id: 'iso-line', type: 'line', source: 'iso', filter: NOTHING, paint: { 'line-color': '#ffffff', 'line-width': 2 } })
+    m.addLayer({
+      id: 'edges-line',
+      type: 'line',
+      source: 'edges',
+      filter: NOTHING,
+      layout: { 'line-cap': 'round', 'line-join': 'round' },
+      paint: {
+        'line-color': ['match', ['get', 'cause'], 'physiology', THEME.cause.physiology, 'slope', THEME.cause.slope, THEME.cause.data],
+        'line-width': 3,
+      },
+    })
+    m.addLayer({
+      id: 'home-line',
+      type: 'line',
+      source: 'home',
+      layout: { 'line-cap': 'round', 'line-join': 'round' },
+      paint: { 'line-color': '#7fd8ff', 'line-width': 2.5, 'line-dasharray': [2, 2] },
+    })
+    m.addLayer({ id: 'legs-casing', type: 'line', source: 'legs', layout: { 'line-cap': 'round', 'line-join': 'round' }, paint: { 'line-color': '#1a120e', 'line-width': 5 } })
+    m.addLayer({ id: 'legs-line', type: 'line', source: 'legs', layout: { 'line-cap': 'round', 'line-join': 'round' }, paint: { 'line-color': THEME.route, 'line-width': 3 } })
+    m.addLayer({ id: 'walked-casing', type: 'line', source: 'walked', layout: { 'line-cap': 'round', 'line-join': 'round' }, paint: { 'line-color': '#1a120e', 'line-width': 5 } })
+    m.addLayer({ id: 'walked-line', type: 'line', source: 'walked', layout: { 'line-cap': 'round', 'line-join': 'round' }, paint: { 'line-color': THEME.walked, 'line-width': 3 } })
+    m.on('click', (e: MapMouseEvent) => this.h.onAdd(e.lngLat.lng, e.lngLat.lat))
+  }
+
+  async setBasemap(sources: BasemapSource[]): Promise<void> {
+    await this.ready
+    if (!sources.length || this.hasBasemap) return
+    sources.forEach((src, i) => {
+      const id = `basemap-${i}`
+      this.basemapIds.push(id)
+      this.map.addSource(id, { type: 'raster', tiles: src.tiles, tileSize: src.tileSize, minzoom: src.minzoom, maxzoom: src.maxzoom, bounds: src.bounds, attribution: src.attribution })
+      this.map.addLayer(
+        { id, type: 'raster', source: id, ...(src.layerMinzoom !== undefined ? { minzoom: src.layerMinzoom } : {}), paint: { 'raster-opacity': THEME.basemapOpacity, 'raster-fade-duration': 0 } },
+        'band-fill',
+      )
+    })
+    this.hasBasemap = true
+    this.applyMapType()
+  }
+
+  /** Topography / material raster over the routing grid (corners NW, NE, SE, SW); replaces the previous one. */
+  async setRelief(url: string, corners: [LonLat, LonLat, LonLat, LonLat]): Promise<void> {
+    await this.ready
+    const m = this.map
+    if (m.getLayer('relief')) m.removeLayer('relief')
+    if (m.getSource('relief')) m.removeSource('relief')
+    if (this.reliefUrl) URL.revokeObjectURL(this.reliefUrl)
+    this.reliefUrl = url
+    m.addSource('relief', { type: 'image', url, coordinates: corners })
+    m.addLayer({ id: 'relief', type: 'raster', source: 'relief', paint: { 'raster-fade-duration': 0, 'raster-resampling': 'linear' } }, 'band-fill')
+    this.applyMapType()
+  }
+
+  /** Satellite shows the HiRISE basemap; topography / material show the relief raster instead. */
+  async setMapType(t: MapType): Promise<void> {
+    await this.ready
+    this.mapType = t
+    this.applyMapType()
+  }
+
+  private applyMapType(): void {
+    const sat = this.mapType === 'satellite'
+    for (const id of this.basemapIds) if (this.map.getLayer(id)) this.map.setLayoutProperty(id, 'visibility', sat ? 'visible' : 'none')
+    if (this.map.getLayer('relief')) this.map.setLayoutProperty('relief', 'visibility', sat ? 'none' : 'visible')
+  }
+
+  async setBoundaryData(d: { bands: BandsFC | null; isochrones: IsochroneFC | null; edges: EdgesFC | null }): Promise<void> {
+    await this.ready
+    ;(this.map.getSource('band') as GeoJSONSource).setData(d.bands ?? EMPTY)
+    ;(this.map.getSource('iso') as GeoJSONSource).setData(d.isochrones ?? EMPTY)
+    ;(this.map.getSource('edges') as GeoJSONSource).setData(d.edges ?? EMPTY)
+  }
+
+  async showBoundary(o: BoundaryOption | undefined): Promise<void> {
+    await this.ready
+    const m = this.map
+    const band: FilterSpecification = o?.kind === 'band' ? ['all', ['==', ['get', 'budget'], o.budget], ['==', ['get', 'variant'], o.variant]] : NOTHING
+    const iso: FilterSpecification = o?.kind === 'iso' ? ['==', ['get', 'minutes'], o.minutes] : NOTHING
+    const edges: FilterSpecification = o?.kind === 'edges' ? ['==', ['get', 'budget'], o.budget] : NOTHING
+    m.setFilter('band-fill', band)
+    m.setFilter('band-line', band)
+    m.setFilter('iso-fill', iso)
+    m.setFilter('iso-line', iso)
+    m.setFilter('edges-line', edges)
+    if (o?.kind === 'band') {
+      const c = THEME.variant[o.variant] ?? THEME.variant.nominal
+      m.setPaintProperty('band-fill', 'fill-color', c)
+      m.setPaintProperty('band-line', 'line-color', c)
+    }
+  }
+
+  setPad(p: { lon: number; lat: number; title: string }): void {
+    this.padMarker?.remove()
+    const el = document.createElement('div')
+    el.className = 'pad-marker'
+    el.textContent = 'Pad'
+    el.title = p.title
+    this.padMarker = new Marker({ element: el }).setLngLat([p.lon, p.lat]).addTo(this.map)
+  }
+
+  /** Science stations: a click opens a popup with "Add as waypoint" and a link to the station card. */
+  setStations(list: { id: string; name: string; lon: number; lat: number; detailHref: string; inPlan: boolean }[], onAdd: (id: string) => void): void {
+    this.stationMarkers.forEach((mk) => mk.remove())
+    this.popup?.remove()
+    this.stationMarkers = list.map((s) => {
+      const el = document.createElement('button')
+      el.type = 'button'
+      el.className = `station-marker mp-station${s.inPlan ? ' in-plan' : ''}`
+      el.textContent = s.id
+      el.title = `${s.id} · ${s.name}: click for options`
+      const box = document.createElement('div')
+      box.className = 'mp-st-pop'
+      const title = document.createElement('b')
+      title.textContent = `${s.id} · ${s.name}`
+      const add = document.createElement('button')
+      add.type = 'button'
+      add.textContent = s.inPlan ? 'Already in the plan' : '+ Add as waypoint'
+      add.disabled = s.inPlan
+      add.addEventListener('click', () => {
+        this.popup?.remove()
+        onAdd(s.id)
+      })
+      const link = document.createElement('a')
+      link.href = s.detailHref
+      link.textContent = 'Details →'
+      const row = document.createElement('div')
+      row.append(add, link)
+      box.append(title, row)
+      // Clicks in the popup must not add a waypoint on the map below.
+      for (const ev of ['mousedown', 'mouseup', 'click', 'dblclick', 'pointerdown', 'pointerup', 'touchstart', 'touchend']) box.addEventListener(ev, (e) => e.stopPropagation())
+      el.addEventListener('click', (e) => {
+        e.stopPropagation()
+        this.popup?.remove()
+        this.popup = new Popup({ offset: 18, closeButton: true, maxWidth: '260px' }).setLngLat([s.lon, s.lat]).setDOMContent(box).addTo(this.map)
+      })
+      return new Marker({ element: el }).setLngLat([s.lon, s.lat]).addTo(this.map)
+    })
+  }
+
+  /** Waypoint markers, numbered from 1, draggable; a drag end moves that waypoint. */
+  setWaypoints(points: { lon: number; lat: number; bad: boolean; info?: string }[]): void {
+    this.markers.forEach((mk) => mk.remove())
+    this.markers = points.map((p, i) => {
+      const el = document.createElement('div')
+      el.className = `mp-wp${p.bad ? ' mp-wp-bad' : ''}`
+      el.textContent = String(i + 1)
+      el.title = `Waypoint ${i + 1}${p.info ? `: ${p.info}` : ''}\nDrag to move`
+      if (p.info) el.classList.add('mp-wp-noted')
+      el.addEventListener('click', (e) => e.stopPropagation()) // a click on a marker never adds a waypoint
+      const mk = new Marker({ element: el, draggable: true }).setLngLat([p.lon, p.lat]).addTo(this.map)
+      mk.on('dragend', () => {
+        const ll = mk.getLngLat()
+        this.h.onMove(i, ll.lng, ll.lat)
+      })
+      return mk
+    })
+  }
+
+  async setRoute(legs: LonLat[][], home: { coords: LonLat[]; reachesPad: boolean } | null): Promise<void> {
+    await this.ready
+    ;(this.map.getSource('legs') as GeoJSONSource).setData({
+      type: 'FeatureCollection',
+      features: legs.filter((c) => c.length > 1).map((coordinates, i) => ({ type: 'Feature', properties: { leg: i + 1 }, geometry: { type: 'LineString', coordinates } })),
+    })
+    ;(this.map.getSource('home') as GeoJSONSource).setData(
+      home && home.coords.length > 1 ? { type: 'FeatureCollection', features: [{ type: 'Feature', properties: { reachesPad: home.reachesPad }, geometry: { type: 'LineString', coordinates: home.coords } }] } : EMPTY,
+    )
+  }
+
+  /** EVA debrief: the track walked in the simulator (eva_log track), or null to remove it. */
+  async setWalked(coords: LonLat[] | null): Promise<void> {
+    await this.ready
+    ;(this.map.getSource('walked') as GeoJSONSource).setData(
+      coords && coords.length > 1 ? { type: 'FeatureCollection', features: [{ type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: coords } }] } : EMPTY,
+    )
+  }
+
+  fitTo(points: LonLat[]): void {
+    if (!points.length) return
+    const b = new LngLatBounds(points[0], points[0])
+    for (const p of points) b.extend(p)
+    this.map.fitBounds(b, { padding: 60, duration: 0, maxZoom: 15 })
+  }
+
+  destroy(): void {
+    this.markers.forEach((mk) => mk.remove())
+    this.stationMarkers.forEach((mk) => mk.remove())
+    this.popup?.remove()
+    this.padMarker?.remove()
+    if (this.reliefUrl) URL.revokeObjectURL(this.reliefUrl)
+    this.map.remove()
+  }
+}
