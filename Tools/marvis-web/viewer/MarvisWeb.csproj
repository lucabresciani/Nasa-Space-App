<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MarvisWeb.exe: the WebView2 window that shows the HOMELINE web app inside the MARVIS (Unity) window.
    .NET Framework 4.8 on purpose: it ships with Windows 10 1903+ and Windows 11, so judges install nothing.
    Never opened by Unity. Build:  dotnet build -c Release   (also refreshes dist/, the folder that ships).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MarvisWeb</AssemblyName>
    <RootNamespace>MarvisWeb</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>MARVIS web viewer</Product>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- dist/ = exactly the files that ship next to the game (x64 loader beside the exe, where the control looks first). -->
  <Target Name="MakeDist" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <DistFile Include="$(OutDir)MarvisWeb.exe;$(OutDir)MarvisWeb.exe.config" />
      <DistFile Include="$(OutDir)Microsoft.Web.WebView2.Core.dll;$(OutDir)Microsoft.Web.WebView2.WinForms.dll" />
      <DistFile Include="$(OutDir)WebView2Loader.dll" />
    </ItemGroup>
    <RemoveDir Directories="$(MSBuildProjectDirectory)\dist" />
    <Copy SourceFiles="@(DistFile)" DestinationFolder="$(MSBuildProjectDirectory)\dist" />
  </Target>

</Project>
