@@ -0,0 +1,111 @@
+// MARTIS bridge: detection is silent off the loopback address and on plain static hosts; the
+// mission hand-over reports the simulator's reason; the walked track is read by column name.
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { EvaLog } from './bridge'
+
+const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } })
+
+/** A fresh copy of the module (detect() caches), with the page at `hostname`. */
+async function bridgeAt(hostname: string, fetchImpl: (url: string, init?: RequestInit) => Promise<Response>) {
+  vi.resetModules()
+  vi.stubGlobal('location', { hostname })
+  const fetchMock = vi.fn(fetchImpl)
+  vi.stubGlobal('fetch', fetchMock)
+  return { b: await import('./bridge'), fetchMock }
+}
+
+afterEach(() => vi.unstubAllGlobals())
+
+describe('detect', () => {
+  it('does not ask at all on a public host', async () => {
+    const { b, fetchMock } = await bridgeAt('luxkaiwalker.github.io', async () => json({ app: 'MARTIS' }))
+    expect(await b.detect()).toBe(false)
+    expect(fetchMock).not.toHaveBeenCalled()
+  })
+
+  it('is true when hello says MARTIS, and asks once', async () => {
+    const { b, fetchMock } = await bridgeAt('127.0.0.1', async () => json({ app: 'MARTIS', bridge: 1, version: '1.0' }))
+    expect(await b.detect()).toBe(true)
+    expect(await b.detect()).toBe(true)
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+    expect(fetchMock.mock.calls[0][0]).toBe('/martis/api/hello')
+  })
+
+  it('is false on a plain static host: 404, an HTML fallback page, another app', async () => {
+    expect(await (await bridgeAt('localhost', async () => new Response('Not found', { status: 404 }))).b.detect()).toBe(false)
+    expect(await (await bridgeAt('localhost', async () => new Response('<!doctype html>', { status: 200 }))).b.detect()).toBe(false)
+    expect(await (await bridgeAt('localhost', async () => json({ app: 'other' }))).b.detect()).toBe(false)
+  })
+
+  it('is false when the request fails', async () => {
+    const { b } = await bridgeAt('127.0.0.1', async () => {
+      throw new TypeError('Failed to fetch')
+    })
+    expect(await b.detect()).toBe(false)
+  })
+
+  it('tries again after a timeout', async () => {
+    let n = 0
+    const { b, fetchMock } = await bridgeAt('127.0.0.1', async () => {
+      if (n++ === 0) throw new DOMException('timed out', 'TimeoutError')
+      return json({ app: 'MARTIS' })
+    })
+    expect(await b.detect()).toBe(true)
+    expect(fetchMock).toHaveBeenCalledTimes(2)
+  })
+})
+
+describe('sendMission', () => {
+  it('posts the document with the X-Martis header', async () => {
+    const { b, fetchMock } = await bridgeAt('127.0.0.1', async () => json({ ok: true, mission_id: 'm-1' }))
+    expect(await b.sendMission({ kind: 'homeline_mission' })).toEqual({ ok: true })
+    const [url, init] = fetchMock.mock.calls[0]
+    expect(url).toBe('/martis/api/mission')
+    expect(init?.method).toBe('POST')
+    expect(init?.headers).toMatchObject({ 'X-Martis': '1', 'Content-Type': 'application/json' })
+    expect(JSON.parse(init?.body as string)).toEqual({ kind: 'homeline_mission' })
+  })
+
+  it("returns the simulator's reason on 422", async () => {
+    const { b } = await bridgeAt('127.0.0.1', async () => json({ ok: false, error: 'pad mismatch' }, 422))
+    expect(await b.sendMission({})).toEqual({ ok: false, error: 'pad mismatch' })
+  })
+
+  it('reports a refusal without a reason, and no answer', async () => {
+    expect(await (await bridgeAt('127.0.0.1', async () => new Response('', { status: 403 }))).b.sendMission({})).toEqual({ ok: false, error: 'HTTP 403' })
+    const { b } = await bridgeAt('127.0.0.1', async () => {
+      throw new TypeError('Failed to fetch')
+    })
+    expect(await b.sendMission({})).toEqual({ ok: false, error: 'MARTIS did not answer' })
+  })
+})
+
+describe('fetchEvaLog and trackLonLat', () => {
+  const log = {
+    kind: 'homeline_eva_log',
+    summary: { complete: true },
+    track: {
+      columns: ['t_min', 'lon', 'lat', 'elev_m', 'cross_track_m', 'schedule_delta_min', 'o2_used_l', 'o2_delta_l', 'margin_min', 'status'],
+      rows: [
+        [0, 137.4, -4.6, -4400, 0, 0, 0, 0, 60, 'ON PLAN'],
+        [0.083, null, null, null, null, null, 0.1, 0, 60, 'ON PLAN'],
+        [0.167, 137.401, -4.601, -4400, 1, 0, 0.2, 0, 60, 'ON PLAN'],
+      ],
+    },
+  } as unknown as EvaLog
+
+  it('returns the log, or null when there is none or it is another document', async () => {
+    expect(await (await bridgeAt('127.0.0.1', async () => json(log))).b.fetchEvaLog()).toEqual(log)
+    expect(await (await bridgeAt('127.0.0.1', async () => json({ ok: false, error: 'no log' }, 404))).b.fetchEvaLog()).toBeNull()
+    expect(await (await bridgeAt('127.0.0.1', async () => json({ kind: 'homeline_mission' }))).b.fetchEvaLog()).toBeNull()
+  })
+
+  it('reads lon and lat by column name and leaves unknown positions out', async () => {
+    const { b } = await bridgeAt('127.0.0.1', async () => json({}))
+    expect(b.trackLonLat(log)).toEqual([
+      [137.4, -4.6],
+      [137.401, -4.601],
+    ])
+    expect(b.trackLonLat({ ...log, track: { columns: ['t_min'], rows: [[0]] } })).toEqual([])
+  })
+})
diff --git a/web/src/martis/bridge.ts b/web/src/martis/bridge.ts
new file mode 100644
index 0000000..9e6c0c2
--- /dev/null
+++ b/web/src/martis/bridge.ts
@@ -0,0 +1,145 @@
+// MARTIS bridge: the page side of the small HTTP API the MARTIS simulator (Unity) serves next to
+// this app when it embeds it. Page and API share one origin (http://127.0.0.1:<port>/), so plain
+// fetch works. Everything here is inert on the public site and on any plain static host:
+// detect() answers false and nothing else is called.
+//   GET  /martis/api/hello    {"app":"MARTIS","bridge":1,"version":"..."}
+//   GET  /martis/api/state    {"seq","planner_visible","eva","mission_id","eva_log_seq","last_error"}
+//   POST /martis/api/mission  mission.json text (header X-Martis: 1) -> {"ok":true,"mission_id"} | 422 {"ok":false,"error"}
+//   GET  /martis/api/eva-log  the latest eva_log document (contracts/bundle/eva_log.schema.json) | 404
+//   POST /martis/api/close    (header X-Martis: 1) -> {"ok":true}
+const API = '/martis/api'
+const POST_HEADERS = { 'Content-Type': 'application/json', 'X-Martis': '1' }
+
+export interface MartisState {
+  /** increases on every change */
+  seq: number
+  planner_visible: boolean
+  /** idle = no web mission loaded; running = loaded, no log yet; complete / ended = its log is in */
+  eva: 'idle' | 'running' | 'complete' | 'ended'
+  mission_id: string | null
+  /** 0 = no log yet; increases with each new log */
+  eva_log_seq: number
+  last_error: string | null
+}
+
+/** The parts of eva_log.json the debrief shows (contracts/bundle/eva_log.schema.json). */
+export interface EvaLog {
+  kind: 'homeline_eva_log'
+  mission_id: string | null
+  title: string
+  label: string
+  /** where the log comes from, in words (the simulator, or a test tool that says so) */
+  origin_label?: string
+  o2_model: string
+  summary: {
+    complete: boolean
+    eva_min: number | null
+    planned_eva_min: number | null
+    waypoints_done: number
+    waypoints_skipped: number
+    stops_left_early: number
+    lowest_margin_min: number | null
+    lowest_binding: string | null
+    max_cross_track_m: number | null
+    o2_used_l: number | null
+    planned_o2_used_l: number | null
+  }
+  events: { t_min: number; kind: string; wp: number | null; detail?: string }[]
+  track: { columns: string[]; rows: (number | string | null)[][] }
+}
+
+let detected: Promise<boolean> | undefined
+
+async function probe(): Promise<boolean> {
+  // MARTIS serves the app on the loopback address only: anywhere else, do not even ask.
+  if (typeof location === 'undefined' || !/^(127\.0\.0\.1|localhost)$/.test(location.hostname)) return false
+  // Any answer is final. Only a timeout is tried again, with more patience: the simulator can be
+  // busy while it starts, and a wrong "no" would hide its controls for the whole session.
+  for (const ms of [800, 2000, 5000]) {
+    try {
+      const res = await fetch(`${API}/hello`, { cache: 'no-store', signal: AbortSignal.timeout(ms) })
+      if (!res.ok) return false
+      return ((await res.json()) as { app?: unknown } | null)?.app === 'MARTIS'
+    } catch (e) {
+      if (!(e instanceof Error && e.name === 'TimeoutError')) return false
+    }
+  }
+  return false
+}
+
+/** True when this page is served by MARTIS. Asked once, then cached; never throws. */
+export function detect(): Promise<boolean> {
+  return (detected ??= probe())
+}
+
+/** Hand a finalized mission document to the simulator; it then hides the planner and starts the EVA. */
+export async function sendMission(doc: unknown): Promise<{ ok: boolean; error?: string }> {
+  try {
+    const res = await fetch(`${API}/mission`, { method: 'POST', headers: POST_HEADERS, body: JSON.stringify(doc) })
+    const j = (await res.json().catch(() => null)) as { ok?: unknown; error?: unknown } | null
+    if (res.ok && j?.ok === true) return { ok: true }
+    return { ok: false, error: typeof j?.error === 'string' && j.error ? j.error : `HTTP ${res.status}` }
+  } catch {
+    return { ok: false, error: 'MARTIS did not answer' }
+  }
+}
+
+/** Hide the planner and return to the simulator's own menu. False when MARTIS did not answer. */
+export async function closePlanner(): Promise<boolean> {
+  try {
+    return (await fetch(`${API}/close`, { method: 'POST', headers: POST_HEADERS })).ok
+  } catch {
+    return false
+  }
+}
+
+/** Call `cb` with the simulator state about once per second while the page is visible. Returns the unsubscribe function. */
+export function watchState(cb: (s: MartisState) => void): () => void {
+  let stopped = false
+  let timer: ReturnType<typeof setTimeout> | undefined
+  const tick = async () => {
+    clearTimeout(timer)
+    if (stopped || document.hidden) return // a hidden page starts again on visibilitychange
+    try {
+      const res = await fetch(`${API}/state`, { cache: 'no-store' })
+      if (res.ok && !stopped) cb((await res.json()) as MartisState)
+    } catch {
+      /* no answer this time: the next tick asks again */
+    }
+    if (!stopped) timer = setTimeout(() => void tick(), 1000)
+  }
+  const onVisible = () => void tick()
+  document.addEventListener('visibilitychange', onVisible)
+  void tick()
+  return () => {
+    stopped = true
+    clearTimeout(timer)
+    document.removeEventListener('visibilitychange', onVisible)
+  }
+}
+
+/** The latest EVA log, or null when there is none (404) or it is not an eva_log document. */
+export async function fetchEvaLog(): Promise<EvaLog | null> {
+  try {
+    const res = await fetch(`${API}/eva-log`, { cache: 'no-store' })
+    if (!res.ok) return null
+    const j = (await res.json()) as EvaLog | null
+    return j?.kind === 'homeline_eva_log' && !!j.summary && Array.isArray(j.track?.rows) ? j : null
+  } catch {
+    return null
+  }
+}
+
+/** The walked track as [lon, lat] points: track.rows by its "lon" and "lat" columns, unknown positions left out. */
+export function trackLonLat(log: EvaLog): [number, number][] {
+  const iLon = log.track.columns.indexOf('lon')
+  const iLat = log.track.columns.indexOf('lat')
+  if (iLon < 0 || iLat < 0) return []
+  const out: [number, number][] = []
+  for (const r of log.track.rows) {
+    const lon = r[iLon]
+    const lat = r[iLat]
+    if (typeof lon === 'number' && typeof lat === 'number') out.push([lon, lat])
+  }
+  return out
+}
